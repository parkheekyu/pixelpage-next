# --- 칼럼(Notion) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=
COLUMN_PUBLISH_SECRET=

# --- 고객사 대시보드 (Supabase) ---
# Supabase 프로젝트 > Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트에 노출 금지 (회원 초대, 웹훅 적재에 사용)
SUPABASE_SERVICE_ROLE_KEY=
# 리드 웹훅 인증 토큰 (Make/n8n 에서 Authorization: Bearer <값>)
LEAD_WEBHOOK_SECRET=
