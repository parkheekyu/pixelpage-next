# --- 칼럼(Notion) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=
COLUMN_PUBLISH_SECRET=

# --- 고객사 대시보드 (Supabase) ---
# Supabase 프로젝트 > Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트에 노출 금지 (회원 초대, 웹훅 적재에 사용)
SUPABASE_SERVICE_ROLE_KEY=
# 리드 웹훅 인증 토큰 (Make/n8n 에서 Authorization: Bearer <값>)
LEAD_WEBHOOK_SECRET=

# --- AI 분석 ---
# 서버에서 바로 실행하려면 (없으면 대기열 + 로컬 워커)
ANTHROPIC_API_KEY=
# 리서치 사전 심층 조사 (선택). 없으면 Claude 웹 검색만 사용
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro  (sonar-deep-research 는 수 분 소요)
# Meta 마케팅 API 토큰 (ads_read)
META_ACCESS_TOKEN=
# GA4 서비스 계정 키 JSON (한 줄)
GA4_SERVICE_ACCOUNT_JSON=

# --- Slack 봇 ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
# 프로젝트 채널이 없을 때 쓰는 기본 채널 ID
SLACK_DEFAULT_CHANNEL=
