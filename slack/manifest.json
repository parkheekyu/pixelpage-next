{
  "display_information": {
    "name": "픽셀페이지 봇"
  },
  "features": {
    "bot_user": {
      "display_name": "pixelpage-bot",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/pixel",
        "url": "https://pixelpage.co.kr/api/slack/commands",
        "description": "픽셀페이지 봇에게 요청",
        "usage_hint": "소재 고객사이름 [메모]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "users:read",
        "reactions:write",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://pixelpage.co.kr/api/slack/events",
      "bot_events": [
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://pixelpage.co.kr/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
